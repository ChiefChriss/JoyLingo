# Copy to .env for local dev. Production (Railway) sets this in the dashboard.
JIMAKU_API_KEY=

# Python stream sidecar (Miruro pipe + Chrome TLS media relay).
MIRURO_API_URL=http://127.0.0.1:8000

# Local dev: clone sample enriched episodes onto common favorite MAL ids (clip matching).
# Set SEED_DEV_ANIME=false to disable. Production skips unless SEED_DEV_ANIME=true.

# Production (Railway)
# PORT=8080
# HOST=0.0.0.0
# API_DATA_DIR=/data
# YT_DLP_BIN=yt-dlp

# AI curriculum teacher (local-dev first — leave unset/false in production)
# TEACHER_ENABLED=true
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Optional local TTS service for personal voice trials (never required for text chat)
# TEACHER_TTS_URL=http://127.0.0.1:8020/tts
