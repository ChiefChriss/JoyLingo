# Railway API URL (no trailing slash). Leave unset in local dev — Vite proxies /api.
# VITE_API_URL=https://your-app.up.railway.app

# AI curriculum teacher — set in .env.local for personal use; leave unset on Vercel.
# VITE_TEACHER_ENABLED=true
# Optional local-only voice (browser speechSynthesis / local TTS). Never set on Vercel by default.
# VITE_TEACHER_VOICE=true
# VITE_TEACHER_TTS_URL=http://127.0.0.1:8020/tts
# Hugging Face speech-to-speech realtime server (npm run teacher:s2s)
# VITE_TEACHER_S2S_URL=ws://127.0.0.1:8765/v1/realtime
