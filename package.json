{
  "name": "joylingo",
  "private": true,
  "version": "0.0.0",
  "description": "Japanese immersion learning app — bring-your-own-media player with an enrichment pipeline",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:web": "npm run build && npm run build -w @joylingo/web",
    "start:api": "node packages/api/dist/main.js",
    "sidecar": "python3 -m uvicorn api:app --host 127.0.0.1 --port 8000 --reload --app-dir sidecar",
    "typecheck": "tsc -b && npm run typecheck -w @joylingo/web",
    "pretest": "npm run build",
    "test": "vitest run",
    "predev": "npm run build",
    "dev": "npm run dev -w @joylingo/web",
    "preapi": "npm run build",
    "api": "npm run dev -w @joylingo/api",
    "enrich": "npm run enrich -w @joylingo/pipeline --",
    "download-jmdict": "npm run download-jmdict -w @joylingo/pipeline",
    "build-kanjidic": "npm run build-kanjidic -w @joylingo/pipeline"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
